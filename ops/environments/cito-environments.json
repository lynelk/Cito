{
  "schemaVersion": 1,
  "sourceOfTruth": {
    "repository": "lynelk/Cito",
    "policy": "All application, configuration-contract, workflow, runbook and release-marker changes must be committed to this repository. Runtime-only changes must be reconciled back to GitHub immediately and may not remain as undocumented drift."
  },
  "railway": {
    "projectName": "Cito",
    "projectId": "8d361df2-d17e-4d15-984e-435735f22f6c",
    "production": {
      "status": "ACTIVE",
      "environmentId": "bec50941-04c7-426d-8bc3-883cbdece892",
      "branch": "production",
      "commitPolicy": "BACKEND_FRONTEND_MATCH_BRANCH_HEAD",
      "services": {
        "backend": {
          "name": "cito-backend",
          "serviceId": "ba6fd4b7-e61d-48d1-987d-7f6dc56c1e84",
          "rootDirectory": "InitializrSpringbootProjectFresh",
          "replicas": 2,
          "region": "ams"
        },
        "frontend": {
          "name": "cito-frontend",
          "serviceId": "fc3dae0c-f602-4242-b66f-9ba7e1491f1f",
          "rootDirectory": "clientside",
          "replicas": 2,
          "region": "ams",
          "publicDomain": "cito.coresynergi.es"
        },
        "database": {
          "name": "MySQL",
          "serviceId": "26c20665-9b31-47b6-ac2c-a984c9b0c6d4"
        }
      }
    },
    "staging": {
      "status": "PLANNED",
      "environmentId": "efde4ddb-0312-48bc-94b2-a096fd3678b0",
      "branch": "main",
      "commitPolicy": "BACKEND_FRONTEND_MATCH_BRANCH_HEAD",
      "autoDeploy": true,
      "isolationPolicy": "NO_PRODUCTION_SECRETS_OR_PROVIDER_BALANCES",
      "dataPolicy": "SYNTHETIC_OR_APPROVED_SANITIZED_DATA_ONLY",
      "promotionPolicy": "EXACT_STAGING_SHA_MUST_PASS_RELEASE_UAT_AND_SMOKE_GATES_BEFORE_PRODUCTION_PROMOTION",
      "provisioningStatus": "SERVICES_RUNNING_REVISION_PARITY_AND_ACCEPTANCE_PENDING",
      "projectId": "c69c90a9-ab6f-48ff-8e04-1e10a10f92db",
      "projectName": "Cito Staging",
      "railwayEnvironmentLabel": "production",
      "candidateBranch": "feature/api-reference-endpoint-billing",
      "services": {
        "backend": {
          "serviceId": "11bdd2d3-c202-43b1-824b-35446a0e6a31",
          "rootDirectory": "InitializrSpringbootProjectFresh",
          "buildCommand": "mvn -B -DskipTests -Dspotless.skip=true clean package --no-transfer-progress",
          "startCommand": "sh /app/start.sh",
          "publicDomain": "cito-staging-backend-production.up.railway.app",
          "springProfile": "staging",
          "nonSecretOverrides": {
            "CPAY_CLEANUP_ENABLED": "false",
            "APP_BASE_URL": "https://cito-staging-backend-production.up.railway.app",
            "CORS_ALLOWED_ORIGINS": "https://cito-staging-backend-production.up.railway.app"
          }
        },
        "frontend": {
          "serviceId": "69ef3eaa-05b5-4504-8f5e-2bfaa27f3512",
          "rootDirectory": "clientside",
          "sourceBranchBinding": "DEFAULT_MAIN",
          "builder": "DOCKERFILE",
          "startCommand": "/start.sh"
        },
        "database": {
          "serviceId": "4fe51073-a138-4ef3-965b-69245786594e",
          "image": "mysql:8.4",
          "persistence": "EPHEMERAL_VALIDATION_ONLY",
          "startCommand": "docker-entrypoint.sh mysqld --log-bin-trust-function-creators=1",
          "initialization": "MYSQL_INITDB_SKIP_TZINFO=1"
        }
      }
    }
  }
}
