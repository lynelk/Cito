<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>net.citotech</groupId>
    <artifactId>cito-fresh</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>cito-platform</name>
    <description>Cito multi-tenant platform with the CPay payments module</description>

    <properties>
        <java.version>21</java.version>
        <netty.version>4.2.16.Final</netty.version>
        <tomcat.version>11.0.25</tomcat.version>
        <spring-security.version>7.1.1</spring-security.version>
        <spring-framework.version>7.0.9</spring-framework.version>
        <!-- Audit K1/K3: tests tagged "docker" (Testcontainers-backed) are excluded from the
             default `mvn test`/`mvn verify` run so an unavailable Docker daemon never breaks the
             build for contributors or CI lanes that don't provision one. A Docker-capable
             environment opts in with: mvn test -Ddocker.tests.excludedGroups= -->
        <docker.tests.excludedGroups>docker</docker.tests.excludedGroups>
        <!-- Audit K5: load-testing toolchain. gatling-maven-plugin's own version scheme
             (4.x) is independent from the Gatling engine version (3.x); 4.21.10 / 3.15.1
             are the current releases of each as of this addition and are the pairing
             Gatling's own documentation and release cadence recommend. -->
        <gatling.version>3.15.1</gatling.version>
        <gatling-maven-plugin.version>4.21.10</gatling-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- Audit J8: dependency currency check. org.json was over two years behind (20240303 ->
             20260719); org.json's frequent dated releases are almost entirely small parser/edge-case
             fixes with no API surface changes, so this is a safe, low-risk bump. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20260719</version>
        </dependency>
        <!-- Audit J8: POI was 3 minor versions behind (5.2.5 -> 5.5.1); still within the 5.x line
             (no OOXML/POIFS API break expected), used only by TabularExportService/
             MerchantStatementExportService's XLSX writer and the spreadsheet-upload validation
             path - both covered by existing tests. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.5.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>
        <!-- Audit J8: bucket4j-core was on 7.6.0 (com.github.vladimir-bukhtoyarov coordinates).
             8.0.1 under those same coordinates is only a relocation stub - Maven prints
             "has been relocated to com.bucket4j:bucket4j-core" - so this now points at the real,
             current artifact directly rather than following the relocation transparently every
             build. The Java package was already io.github.bucket4j.* (not com.github.bucket4j.*),
             which is unchanged by this coordinate switch. RateLimiterService (the only consumer)
             uses only Bandwidth/Bucket/Refill, all present and source-compatible in 8.0.1. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>3.1.0</version>
        </dependency>
        <!-- Audit H1: routes any remaining java.util.logging output (our own not-yet-converted
             classes, and third-party libraries) through the same SLF4J/Logback pipeline as the
             rest of the app, instead of a second, differently-formatted logging path. Installed at
             startup by CpayadminApplication (retained as the legacy boot-entry class for
             compatibility while the product identity is Cito). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Structured JSON console logging (logback-spring.xml CONSOLE_JSON appender).
             Without this the packaged jar fails at startup with ClassNotFoundException:
             net.logstash.logback.encoder.LogstashEncoder. Sliced-context tests never boot
             the full logback config, so `mvn verify` alone does not catch a missing encoder. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
        </dependency>
        <!-- Audit G1: distributed locking for crons that are both @Scheduled and directly
             HTTP-triggerable (TransactionsLogController.testCheckstatusCron / .paymentsPayCron),
             so a multi-instance/HA deployment can't run the same money-movement batch on two
             instances at once. 7.7.0 pinned (not the 5.x line) because it targets Spring
             Framework 7.0.x/Spring Boot 4.x, matching this app's spring-boot-starter-parent
             4.1.0 (Spring Framework 7.0.8); shedlock-spring 5.x targets Spring Framework 6.1 and
             is not the right match here. Verified both artifacts resolve cleanly from Maven
             Central at 7.7.0 via `mvn dependency:get`. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>7.7.0</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>7.7.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Audit E3: @WithMockUser / method-security test support for the new @PreAuthorize checks. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only embedded DB for SchedulerLockConfigTest: exercises the real
             JdbcTemplateLockProvider/shedlock table against a real (if in-memory) SQL engine,
             since the app otherwise only runs against MySQL and no MySQL instance is available
             in the test environment. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Audit K1: Testcontainers-based DB integration tests. Versions are managed by the
             org.testcontainers:testcontainers-bom that spring-boot-dependencies already imports
             (see spring-boot-dependencies 4.1.0's <testcontainers.version>), so no explicit
             version is declared here. These tests additionally require a running Docker daemon;
             see the docker.tests.excludedGroups property below for how they are kept out of the
             default `mvn test` run. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Audit K2: WireMock-based provider API mocking tests. wiremock-standalone shades its
             own Jetty/Jackson/Guava so it cannot collide with the versions Spring Boot manages
             for the application itself. Not covered by the Spring Boot BOM, so pinned explicitly
             to the latest stable (non-beta) release. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Audit K5: Gatling load-testing simulations under src/test/java/.../loadtest.
             Test-scoped only: pulls in gatling-app (Java DSL, engine) and the
             highcharts report writer transitively. This does NOT make Gatling run as
             part of `mvn test`: JUnit/Surefire only picks up classes matching its
             default *Test/*Tests/*TestCase naming patterns, and our simulation classes
             are named *Simulation, so they are compiled but never executed by `mvn
             test` or `mvn verify`. Run them explicitly with `mvn gatling:test`. -->
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${docker.tests.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- Audit K5: deliberately NO <executions> block here. Without one, this
                 plugin's `test` goal is not bound to any lifecycle phase, so it never
                 runs as a side effect of `mvn compile` / `mvn test` / `mvn verify` /
                 `mvn package`. It only runs on an explicit `mvn gatling:test`
                 invocation (which itself forks the build up to test-compile first, so
                 simulations under src/test/java are freshly compiled before running). -->
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
            </plugin>
            <!-- Audit J6: formatting enforcement, introduced carefully on a codebase that has
                 never had one - AOSP style (4-space indent) is used, not Google's default 2-space,
                 because it matches this codebase's existing indentation and so minimizes the diff
                 the FIRST time an existing file is touched after this lands. ratchetFrom=origin/main
                 means spotless:check only validates files that actually differ from origin/main -
                 untouched legacy files are grandfathered in rather than requiring an immediate,
                 disruptive mass-reformat of the whole codebase. Deliberately bound to the `verify`
                 phase (not `compile`/`test`) so a local `mvn test` iteration loop is never blocked
                 by formatting while still gating `mvn verify`/CI. Run `mvn spotless:apply` to
                 auto-fix a file this flags. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.46.1</version>
                <configuration>
                    <ratchetFrom>origin/main</ratchetFrom>
                    <java>
                        <googleJavaFormat>
                            <!-- Track A follow-up: 1.22.0 calls a javac internal
                                 (Log$DeferredDiagnosticHandler.getDiagnostics()) whose signature
                                 changed in JDK 24+, so `mvn verify`'s Spotless step crashed with
                                 NoSuchMethodError on JDK 25/26. 1.34.0+ adds newer-JDK support;
                                 1.36.1 is the current release and still requires/works on the
                                 JDK 21 baseline CI uses. -->
                            <version>1.36.1</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
