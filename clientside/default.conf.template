upstream cito-backend {
    zone cito_backend 64k;
    resolver ${DNS_RESOLVER} valid=10s ipv4=on ipv6=on;
    resolver_timeout 3s;
    server ${BACKEND_UPSTREAM} resolve;
}

server {
    # Railway private networking is dual-stack. Bind explicitly on both stacks
    # so health checks and public proxy traffic can reach nginx reliably.
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Liveness: nginx itself is serving traffic.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # Immutable build identity. Unlike readiness, this is served by the
    # frontend image itself so release checks cannot mistake a fresh backend
    # behind stale UI assets for an exact-head deployment.
    location = /releasez {
        access_log off;
        default_type application/json;
        add_header Cache-Control "no-store, max-age=0" always;
        try_files $uri =404;
    }

    # Readiness: nginx can reach the CPay backend over Railway private
    # networking. Keep this deliberately narrow and fast so a broken upstream
    # fails deployments instead of leaving a superficially healthy frontend.
    location = /readyz {
        access_log off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_pass http://cito-backend/status/health;
    }

    # Browser-internal controller calls use /api/ui. Remove only that UI
    # namespace before forwarding because Spring exposes those controllers at
    # paths such as /auth, /merchants and /settings.
    location = /api/ui {
        return 308 /api/ui/;
    }

    location /api/ui/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://cito-backend/;
    }

    # Expose the backend health endpoint through the single public edge for
    # production acceptance checks without changing the backend route itself.
    location = /api/status/health {
        access_log off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_pass http://cito-backend/status/health;
    }

    # Preserve the legacy public backend health URL without capturing the
    # customer-facing React Router /status page.
    location = /status/health {
        access_log off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_pass http://cito-backend/status/health;
    }

    # Public CPay gateway. Preserve /api because the backend already exposes
    # versioned contracts such as /api/v1 and /api/v2. This avoids breaking
    # existing merchant integrations during the single-domain cutover.
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://cito-backend;
    }

    # Temporary compatibility for older clients/bookmarks that called backend
    # controller families directly on the UI origin. New browser traffic uses
    # /api/ui while external integrations continue to use /api.
    location ~ ^/(auth|admins|merchants|settings|audittrail|transactions|actuator|v3|swagger-ui)(/|$) {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://cito-backend;
    }

    # Fingerprinted Vite assets can be cached aggressively.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # React Router history fallback. /bo and its deep links are therefore
    # served by the same SPA without needing a second public service.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
